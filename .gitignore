# Local environment
.env
.env.*
.envrc
.envrc.local
.direnv/
.codex

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Nix build outputs
/result
/result-*

# Runtime outputs
/raw.latest
/clean.latest
/clean.plain.latest
/diagnostics.latest.json
/recording.latest.wav
/speech_notes.txt
/logs/

# Test fixtures (user-supplied recordings; see tests/fixtures/README.md)
/tests/fixtures/*.wav

# Scratch outputs
/tmp/

# Eval material that must never enter history: real-recording cases and raw model
# replies (which quote them). Synthetic committed cases live in evals/cases/.
/evals/local/
/evals/out/
